{
  "manifest_version": 2,
  "name": "Tor Domain Isolator",
  "version": "0.1.4",
  "description": "Isolates Tor SOCKS5 streams by first-party hostname, Firefox container, and normal/private browsing context. Requires a local Tor service.",
  "developer": {
    "name": "Ivan Bukvic",
    "url": "https://github.com/IBU4/Tor-Domain-Isolator"
  },
  "icons": {
    "48": "icons/tor-domain-isolator-48.png",
    "96": "icons/tor-domain-isolator-96.png",
    "128": "icons/tor-domain-isolator-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tor-domain-isolator@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "proxy",
    "tabs",
    "webNavigation",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_icon": "icons/tor-domain-isolator.svg",
    "default_title": "Tor Domain Isolator",
    "default_popup": "popup.html"
  }
}
